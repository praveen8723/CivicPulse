# Local Ollama runs by default at 127.0.0.1:11434 using llama3.2:latest.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# Optional external provider if Ollama is unavailable; keyword rules remain the final fallback.
# Endpoint must accept { description } and return { category, confidence, summary }.
ISSUE_ANALYSIS_URL=
ISSUE_ANALYSIS_KEY=
